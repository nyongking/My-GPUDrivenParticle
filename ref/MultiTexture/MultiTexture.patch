+// Distort ¸¦ »« ¿¬»ê. s = ·¹ÀÌ¾î ÅØ½ºÃ³ »ùÇÃ, p = LayerParam
+float4 ApplyLayer(float4 premul, float coverage, SpriteLayerGpu L, float4 s, float p)

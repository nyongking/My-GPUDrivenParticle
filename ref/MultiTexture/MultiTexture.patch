+// C++ SpriteLayerGpu ¿Í °°Àº ¹èÄ¡ (80 B, 16 B ÁÙ 5°³)
+struct SpriteLayerGpu
+{
+    uint Op;
+    uint UV;
+    uint Channel;
+    uint Flags;
+    float2 Tiling;

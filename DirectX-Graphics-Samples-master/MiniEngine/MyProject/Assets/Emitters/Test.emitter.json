{
  "format": "MyProject.Emitter",
  "version": 1,
  "name": "Test",
  "capacity": 10000,
  "backend": "Gpu",
  "modules": [
    {
      "module": "SpawnRate",
      "params": {
        "Rate": 50
      }
    },
    {
      "module": "InitializeParticle",
      "params": {
        "Size": 0.1,
        "Mass": 1,
        "Lifetime": 1,
        "Pos": {
          "min": [0.3, 0.1, 0],
          "max": [-0.3, -0.1, 0],
          "perComponent": true
        },
        "Color": [1, 1, 1, 1]
      }
    },
    {
      "module": "SphereLocation",
      "params": {
        "Radius": 0.1,
        "SurfaceOnly": true
      }
    },
    {
      "module": "ParticleState",
      "params": {
        "KillOnLifetime": true
      }
    },
    {
      "module": "GravityForce",
      "params": {
        "Gravity": [0, -4, 0]
      }
    },
    {
      "module": "AddVelocityInCone",
      "params": {
        "Speed": 4,
        "ConeAngle": 30,
        "ConeAxis": [0, 1, 0],
        "InnerConeAngle": 0,
        "SpeedFalloff": 0,
        "Distribution": 1,
        "LocalSpace": false
      }
    },
    {
      "module": "SolveForceAndVelocity",
      "params": {
        "AccelLimit": 100,
        "SpeedLimit": 10
      }
    }
  ],
  "sprite": {
    "texture": "Assets/Textures/T_FX_CMN_Dust_01.dds",
    "textureAlpha": "FromLuminance",
    "blend": "Translucent",
    "subImage": [1, 1],
    "subUVBlend": false,
    "facing": "FaceCameraPosition",
    "alignment": "VelocityAligned",
    "pivot": [0.5, 0.5],
    "cameraOffset": 0,
    "velocityStretch": 0,
    "blendNear": 1,
    "blendFar": 10,
    "layers": [],
    "bindings": {
      "Position": {
        "attribute": "Particles.Position",
        "default": [0, 0, 0]
      },
      "Color": {
        "attribute": "Particles.Color",
        "default": [1, 1, 1, 1]
      },
      "Size": {
        "attribute": "Particles.Size",
        "default": 0.1
      },
      "SubImageIndex": {
        "attribute": "Particles.SubImageIndex",
        "default": 0
      },
      "SpriteSize": {
        "attribute": "Particles.SpriteSize",
        "default": [0.2, 0.2]
      },
      "SpriteRotation": {
        "attribute": "Particles.SpriteRotation",
        "default": 0
      },
      "Velocity": {
        "attribute": "Particles.Velocity",
        "default": [0, 0, 0]
      },
      "SpriteFacing": {
        "attribute": "",
        "default": [0, 1, 0]
      },
      "SpriteAlignment": {
        "attribute": "",
        "default": [0, 1, 0]
      },
      "MaterialParam0": {
        "attribute": "",
        "default": 0
      },
      "MaterialParam1": {
        "attribute": "",
        "default": 0
      }
    }
  }

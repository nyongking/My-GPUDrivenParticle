{
  "format": "MyProject.Emitter",
  "version": 1,
  "name": "Fire_New",
  "capacity": 10000,
  "backend": "Gpu",
  "modules": [
    {
      "module": "SpawnRate",
      "params": {
        "Rate": 50
      }
    },
    {
      "module": "InitializeParticle",
      "params": {
        "Size": 0.1,
        "Mass": 1,
        "Lifetime": 1,
        "Pos": {
          "min": [0, 0, 0],
          "max": [0, 0, 0],
          "perComponent": true
        },
        "Color": [1, 0.475, 0.18, 1]
      }
    },
    {
      "module": "ParticleState",
      "params": {
        "KillOnLifetime": true
      }
    },
    {
      "module": "SubUVAnimation",
      "params": {
        "StartFrame": 0,
        "EndFrame": 35,
        "Loop": false,
        "FramesPerSecond": 30
      }
    },
    {
      "module": "SphereLocation",
      "params": {
        "Radius": 0.01,
        "SurfaceOnly": false
      }
    },
    {
      "module": "CurlNoiseForce",
      "params": {
        "Strength": 0.3,
        "Frequency": 3,
        "Offset": [0, 1, 0],
        "Pan": [0, 0, 0]
      }
    },
    {
      "module": "AddVelocityInCone",
      "params": {
        "Speed": 0.5,
        "ConeAngle": 15,
        "ConeAxis": [0, 1, 0],
        "InnerConeAngle": 0,
        "SpeedFalloff": 0.5,
        "Distribution": 1,
        "LocalSpace": false
      }
    },
    {
      "module": "SolveForceAndVelocity",
      "params": {
        "AccelLimit": 100,
        "SpeedLimit": 10
      }
    },
    {
      "module": "InitializeSprite",
      "params": {
        "SpriteSize": [0.15, 0.15],
        "SpriteRotation": {
          "min": 30,
          "max": -30
        }
      }
    }
  ],
  "sprite": {
    "texture": "Assets/Textures/T_Fire_subUV.PNG",
    "textureAlpha": "FromLuminance",
    "blend": "Translucent",
    "subImage": [6, 6],
    "subUVBlend": true,
    "facing": "FaceCameraPlane",
    "alignment": "CustomAlignment",
    "pivot": [0.5, 0.5],
    "cameraOffset": 0,
    "velocityStretch": 0,
    "blendNear": 1,
    "blendFar": 10,
    "layers": [],
    "bindings": {
      "Position": {
        "attribute": "Particles.Position",
        "default": [0, 0, 0]
      },
      "Color": {
        "attribute": "Particles.Color",
        "default": [1, 1, 1, 1]
      },
      "Size": {
        "attribute": "Particles.Size",
        "default": 0.1
      },
      "SubImageIndex": {
        "attribute": "Particles.SubImageIndex",
        "default": 0
      },
      "SpriteSize": {
        "attribute": "Particles.SpriteSize",
        "default": [0.2, 0.2]
      },
      "SpriteRotation": {
        "attribute": "Particles.SpriteRotation",
        "default": 0
      },
      "Velocity": {
        "attribute": "Particles.Velocity",
        "default": [0, 0, 0]
      },
      "SpriteFacing": {
        "attribute": "Particles.SpriteFacing",
        "default": [0, 1, 0]
      },
      "SpriteAlignment": {
        "attribute": "Particles.SpriteAlignment",
        "default": [0, 1, 0]
      },
      "MaterialParam0": {
        "attribute": "",
        "default": 0
      },
      "MaterialParam1": {
        "attribute": "",
        "default": 0
      }
    }

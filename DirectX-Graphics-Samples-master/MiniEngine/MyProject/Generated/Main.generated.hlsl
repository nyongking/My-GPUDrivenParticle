[numthreads(1, 1, 1)]
void EmitterUpdateMain()
{
    EmitterState e = LoadEmitter();
    e.SpawnCount = 0;   // spawn modules accumulate with +=
    EmitterUpdate(e);
    StoreEmitter(e);

    const uint request = min(e.SpawnCount, Capacity);
    Counters.Store(COUNTER_SPAWN_REQUEST, request);
    IndirectArgs.Store3(0, uint3((request + GROUP_SIZE - 1) / GROUP_SIZE, 1, 1));
}

[numthreads(GROUP_SIZE, 1, 1)]
void ParticleUpdateMain(uint3 dtid : SV_DispatchThreadID)
{
    const uint i = dtid.x;
    if (i >= Counters.Load(COUNTER_ALIVE_IN))
        return;

    const RenderParticle r = RenderIn[i];
    Particle p = LoadParticle(ParticlesIn, r, i);
    bool alive = true;
    ParticleUpdate(p, i, alive);
    if (!alive)
        return;   // not written to Out = compaction

    uint dst;
    Counters.InterlockedAdd(COUNTER_WRITE_CURSOR, 1, dst);
    StoreParticle(ParticlesOut, dst, p, r);
}

[numthreads(GROUP_SIZE, 1, 1)]
void ParticleSpawnMain(uint3 dtid : SV_DispatchThreadID)
{
    if (dtid.x >= Counters.Load(COUNTER_SPAWN_REQUEST))
        return;

    uint dst;
    Counters.InterlockedAdd(COUNTER_WRITE_CURSOR, 1, dst);
    if (dst >= Capacity)
        return;   // overflow is clamped by Finalize

    // render attributes start from the CPU-side defaults, the rest from 0 (CPU ZeroRange)
    Particle p = FromRender(DefaultRender);
    ParticleSpawn(p, dst);      // random index = slot index (same as CPU)
    StoreParticle(ParticlesOut, dst, p, DefaultRender);
}
